# ==============================================================================
# Roundset Environment Variables Template (.env.example)
#
# POLICY:
# - NEVER commit real credentials, API tokens, or connection strings.
# - Phase 1 bootstrap uses placeholder values only.
# - Commercial constraint: ₹0 infrastructure operating cost.
# - MOCK_DATABASE=true is for isolated local testing and MUST be rejected in production.
# ==============================================================================

# Server Runtime Configuration
NODE_ENV=development
PORT=8787
WEB_ORIGIN=http://localhost:5173

# Database (MongoDB Atlas Free Tier)
# In local development/testing, MOCK_DATABASE=true bypasses live connection
MONGODB_URI=mongodb+srv://placeholder_user:placeholder_pass@cluster.mongodb.net/roundset?retryWrites=true&w=majority
MOCK_DATABASE=true

# Authentication (Firebase Google OAuth)
FIREBASE_PROJECT_ID=placeholder-roundset-dev

# AI Inference (Groq - Primary Qwen 3.8 27B)
GROQ_API_KEY=gsk_placeholder_groq_api_key
GROQ_MODEL=qwen/qwen3.8-27b

# AI Inference (Cloudflare Workers AI - Contingent Fallback Only)
CLOUDFLARE_ACCOUNT_ID=placeholder_cloudflare_account_id
CLOUDFLARE_AI_TOKEN=placeholder_cloudflare_ai_token

# Email & Verification (Brevo Free Tier HTTPS API)
EMAIL_PROVIDER=brevo
BREVO_API_KEY=xkeysib-placeholder_brevo_api_key

# SMS Verification (Mock provider baseline; SMS credits are sole permitted paid exception)
SMS_PROVIDER=mock

# Billing & Monetization (Sandbox-only testing in Phase 1)
BILLING_MODE=sandbox

# Initial Administration Bootstrap
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
